# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
env/

# Environment variables / secrets
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Sample/downloaded documents (avoid committing large/PII data)
# Code inside app/data/ (like generators) is NOT ignored — only this
# dedicated samples subfolder is.
app/data/samples/*
!app/data/samples/.gitkeep

# Logs
*.log

# Distribution / build
build/
dist/
*.egg-info/

# Local Claude Code context (personal design docs, not for git)
/CLAUDE.md
/context/
